---
import Base from '../layouts/Base.astro';
import { links } from '../lib/content.mjs';
---
<Base title="유용한 링크 모음"><header class="page-heading"><h1>곁에 두는 웹사이트.</h1><p>개발과 작업에 도움이 되는 도구, 자주 찾는 자료를 모았습니다.</p></header><div class="resource-grid">{links.map((link: any) => <a class="resource" href={link.url} target="_blank" rel="noopener noreferrer"><div class="resource-image"><img src={`/assets/images/${link.screenshot}`} alt={`${link.domain} 화면`} loading="lazy" width="560" height="320"/></div><div class="post-meta"><span>{link.domain}</span><span aria-hidden="true">↗</span></div><h2>{link.title}</h2><p>{link.description || '사이트에서 자세한 내용을 확인하세요.'}</p></a>)}</div></Base>
