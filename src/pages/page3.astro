---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { visiblePosts } from '../lib/content.mjs';
const isEmpty = visiblePosts.length <= 12;
---
<Base title="기록 3페이지" redirectTo={isEmpty ? '/#records' : undefined}><header class="page-heading"><h1>{isEmpty ? '모든 기록을 한곳에서.' : '쌓아가는 기록.'}</h1><p>{isEmpty ? '전체 기록으로 이동합니다.' : '3페이지'}</p></header><PostList posts={visiblePosts.slice(12, 18)} /><a class="text-link" href="/">전체 기록 보기 ↗</a></Base>
